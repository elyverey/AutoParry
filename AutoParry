    local function doParry(force,killerChar,distance)
        if not STATE.autoParryEnabled then return false end
        local now=tick()
        if now-STATE.lastParryTime<0.01 then return false end
        if killerChar and distance then
            local allowedRange=STATE.autoParryRadius
            local allowVault=false
            local data=STATE.activeAttackers[killerChar]
            if data and data.profile and data.profile.type=="lungehold" then
                allowVault=true
            end
            if distance>allowedRange then return false end
            local function pathClear()
                local localChar=localPlayer.Character
                local localRoot=localChar and localChar:FindFirstChild("HumanoidRootPart")
                local killerRoot=killerChar:FindFirstChild("HumanoidRootPart")
                if not localRoot or not killerRoot then return false end
                local origin=localRoot.Position
                local target=killerRoot.Position
                local direction=target-origin
                if direction.Magnitude<=0.05 then return true end
                local params=RaycastParams.new()
                params.FilterType=Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances={localChar,killerChar}
                params.IgnoreWater=true
                local offsets={Vector3.new(0,0,0),Vector3.new(0,1.1,0),Vector3.new(0,-0.75,0)}
                local vaultHit=false
                for _,offset in ipairs(offsets) do
                    local result=Workspace:Raycast(origin+offset,direction,params)
                    if not result then return true end
                    local hit=result.Instance
                    if hit then
                        local n=hit.Name:lower()
                        if n:find("vault") or n:find("window") or n:find("ledge") then
                            vaultHit=true
                        end
                    end
                end
                if allowVault and vaultHit and distance<=allowedRange+VAULT_EXTRA_RANGE then
                    return true
                end
                return false
            end
            if not pathClear() then return false end
        end
        STATE.lastParryTime=now
        sendParryInput()
        return true
    end
    local function doSkillParry()
        if not STATE.autoParryEnabled then return false end
