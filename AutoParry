                    local killerPos=killerRoot.Position
                    local killerVelocity=getFlatVelocity(killerRoot)
                    local offset=localPos-killerPos
                    local distance=offset.Magnitude
                    local flatOffset=Vector3.new(offset.X,0,offset.Z)
                    local flatLocalVelocity=localVel
                    local closingSpeed=0
                    if flatOffset.Magnitude>0 then
                        closingSpeed=(killerVelocity-flatLocalVelocity):Dot(flatOffset.Unit)
                    end
                    local timeToImpact=math.huge
                    if closingSpeed>0 then
                        timeToImpact=distance/closingSpeed
                    end
                    local position=data.track.TimePosition or 0
                    local realLength=data.track.Length
                    local length=(realLength and realLength>0) and realLength or profile.length
                    local speed=profile.speed
