    MainSection:AddToggle("IgnoreHidden",{Title="The Hidden",Default=false,Callback=function(v)
        STATE.ignoredTheHidden=v
        if v then table.clear(STATE.activeSkillAttackers) end
    end})
    MainSection:AddToggle("IgnoreAbysswalker",{Title="The Abysswalker",Default=false,Callback=function(v)
        STATE.ignoredTheAbysswalker=v
    end})
    MainSection:AddToggle("IgnoreMaskedDuck",{Title="The Masked (Duck)",Default=false,Callback=function(v)
        STATE.ignoredTheMaskedDuck=v
        if v then table.clear(STATE.activeMaskedSkillAttackers) end
    end})
    MainSection:AddSlider("ParryRadius",{Title="Parry Radius",Default=11,Min=4,Max=40,Rounding=1,Callback=function(v)
