                    local normalizedLength=length/speed
                    local progress=normalizedLength>0 and normalizedTime/normalizedLength or 0
                    local triggerTime=profile.triggerTime/profile.speed
                    local triggerProgress=profile.triggerProgress
                    local animationReady=position>=triggerTime or progress>=triggerProgress
                    local shouldParry=false
                    local isLunge=data.type=="lungehold"
                    if isLunge then
                        local lungeReady=closingSpeed>=LUNGE_MIN_SPEED and timeToImpact<=LUNGE_EARLY_TIME
