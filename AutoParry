    p.CFrame=root.CFrame*CFrame.Angles(0,0,math.rad(90))
    p.Anchored=true
    p.CanCollide=false
    p.CanQuery=false
    p.CanTouch=false
    p.Transparency=0.75
    p.Material=Enum.Material.ForceField
    p.Parent=Workspace
    radiusPart=p
end
RunService.RenderStepped:Connect(function()
    if radiusPart then
        local char=localPlayer.Character
        local root=char and char:FindFirstChild("HumanoidRootPart")
        if root then
            radiusPart.CFrame=CFrame.new(root.Position)*CFrame.Angles(0,0,math.rad(90))
            radiusPart.Size=Vector3.new(0.12,STATE.autoParryRadius*2,STATE.autoParryRadius*2)
        end
    end
end)
local function BuildUI()
    local Window=Chloex:MakeWindow({Title="BOLONG-HUB "..VERSION,SubTitle="Auto Parry",SaveFolder="BOLONG-HUB"})
    local MainTab=Window:MakeTab({Title="Combat",Icon="sword"})
    MainTab:AddToggle({Title="Auto Parry",Default=false,Callback=function(v)
        STATE.autoParryEnabled=v
        if not v then
            for _,data in pairs(STATE.activeAttackers) do
                if data then data.consumed=false end
            end
            table.clear(STATE.activeSkillAttackers)
            table.clear(STATE.activeMaskedSkillAttackers)
        end
    end})
    MainTab:AddToggle({Title="Show Parry Radius",Default=false,Callback=function(v)
        STATE.autoParryRadiusEsp=v
        updateRadiusESP()
    end})
    MainTab:AddSlider({Title="Parry Radius",Min=4,Max=30,Default=10,Rounding=1,Callback=function(v)
        STATE.autoParryRadius=v
        if STATE.autoParryRadiusEsp then updateRadiusESP() end
    end})
    MainTab:AddSlider({Title="Aim Strictness",Min=0,Max=1,Default=0.1,Rounding=2,Callback=function(v)
        STATE.aimStrictness=v
    end})
    MainTab:AddToggle({Title="Ignore The Hidden",Default=false,Callback=function(v)
        STATE.ignoredTheHidden=v
        if v then table.clear(STATE.activeSkillAttackers) end
    end})
    MainTab:AddToggle({Title="Ignore The Abysswalker",Default=false,Callback=function(v)
        STATE.ignoredTheAbysswalker=v
    end})
    MainTab:AddToggle({Title="Ignore The Masked (Duck)",Default=false,Callback=function(v)
        STATE.ignoredTheMaskedDuck=v
        if v then table.clear(STATE.activeMaskedSkillAttackers) end
    end})
    local InfoTab=Window:MakeTab({Title="Info",Icon="info"})
    InfoTab:AddParagraph({Title="Auto Parry",Content="Animation timing + distance + movement prediction"})
    InfoTab:AddParagraph({Title="Version",Content=VERSION})
    return Window
end
BuildUI()
RegisterTask("RadiusESPUpdate",0,function()
    if STATE.autoParryRadiusEsp then
        local char=localPlayer.Character
        local root=char and char:FindFirstChild("HumanoidRootPart")
        if root and radiusPart then
            radiusPart.CFrame=CFrame.new(root.Position)*CFrame.Angles(0,0,math.rad(90))
        end
    end
end)
RunService.Heartbeat:Connect(function(dt)
    for _,taskData in ipairs(MasterTasks) do
        taskData.timer=taskData.timer+dt
        if taskData.timer>=taskData.interval then
            taskData.timer=0
            task.spawn(taskData.fn)
        end
    end
end)
