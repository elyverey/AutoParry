                        STATE.activeSkillAttackers[char]=nil
                    end
                end
                for char,data in pairs(STATE.activeMaskedSkillAttackers) do
                    if data.name and (data.name:lower()=="the masked (duck)" or data.name:lower()=="the masked") then
                        STATE.activeMaskedSkillAttackers[char]=nil
                    end
                end
            end
        end,
    })
    APSection:AddSlider({
        Title="Parry Radius (Stud)",Min=4,Max=40,Default=11,Increment=1,
        Callback=function(v)
            STATE.autoParryRadius=v
        end,
    })
    APSection:AddSlider({
        Title="Aim Strictness",Min=-1,Max=1,Default=0.1,Increment=0.1,
        Callback=function(v)
            STATE.aimStrictness=v
        end,
    })
end
