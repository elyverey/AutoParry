    local function validateAndParry(killerChar,killerName,instant,extraRadius)
        local localChar=localPlayer.Character
        if not localChar then return false end
        local localRoot=localChar:FindFirstChild("HumanoidRootPart")
        if not localRoot then return false end
        local killerRoot=killerChar:FindFirstChild("HumanoidRootPart")
        if not killerRoot then return false end
        local maxRadius=STATE.autoParryRadius+(extraRadius or 0)
        local distance=(localRoot.Position-killerRoot.Position).Magnitude
        if distance>maxRadius then return false end
        if instant then
            doParry()
            return true
        end
        local ping=Players.LocalPlayer:GetNetworkPing()
        local clampedPing=math.clamp(ping,0,0.3)
        local killerVel=killerRoot.AssemblyLinearVelocity
        local flatKillerVel=Vector3.new(killerVel.X,0,killerVel.Z)
        local predictedKillerPos=killerRoot.Position+(flatKillerVel*clampedPing)
        local distVec=localRoot.Position-predictedKillerPos
        local predictedDistance=distVec.Magnitude
        if predictedDistance>maxRadius+2 then return false end
        local directionToPlayer=localRoot.Position-killerRoot.Position
        if directionToPlayer.Magnitude<=0 then
            doParry()
            return true
        end
        directionToPlayer=directionToPlayer.Unit
        if flatKillerVel.Magnitude>8 then
            local velDot=flatKillerVel.Unit:Dot(directionToPlayer)
            if velDot<-0.1 then return false end
        end
        local killerFacing=killerRoot.CFrame.LookVector
        local flatFacing=Vector3.new(killerFacing.X,0,killerFacing.Z)
        if flatFacing.Magnitude<=0 then return false end
        flatFacing=flatFacing.Unit
        local dot=flatFacing:Dot(directionToPlayer)
        if dot<STATE.aimStrictness then return false end
        local rayParams=RaycastParams.new()
        rayParams.FilterDescendantsInstances={localChar,killerChar}
        rayParams.FilterType=Enum.RaycastFilterType.Exclude
        local rayDirection=localRoot.Position-killerRoot.Position
        local hit=Workspace:Raycast(killerRoot.Position,rayDirection,rayParams)
        if hit and hit.Instance and not hit.Instance:IsDescendantOf(localChar) then return false end
        doParry()
        return true
    end
    local function isRealAttackPhase(data)
        local track=data.track
        if not track or not track.IsPlaying then return false end
        local position=track.TimePosition or 0
        local length=track.Length or 0
        local knownLength=ANIM_LENGTHS[data.id]
        local effectiveLength=knownLength or length
        local isFastAttack=FAST_ATTACK_ANIMS[data.id] or false
        local minPosition
        local minProgress
        if isFastAttack then
            if effectiveLength<=1.05 then
                minPosition=0.018
                minProgress=0.012
            elseif effectiveLength<=1.55 then
                minPosition=0.022
                minProgress=0.014
            elseif effectiveLength<=1.80 then
                minPosition=0.025
                minProgress=0.015
            else
                minPosition=0.035
                minProgress=0.018
            end
        else
            minPosition=0.06
            minProgress=0.04
        end
        if position<minPosition then return false end
        if effectiveLength>0 then
            local progress=position/effectiveLength
            if progress<minProgress then return false end
            if progress>0.985 then return false end
        end
        local weight=track.WeightCurrent or 0
        if weight<=0.005 then return false end
        local priority=track.Priority
        if priority==Enum.AnimationPriority.Core or priority==Enum.AnimationPriority.Idle or priority==Enum.AnimationPriority.Movement then return false end
        if data.lastTimePosition and position+0.0001<data.lastTimePosition then
            data.lastTimePosition=position
            return false
        end
        data.lastTimePosition=position
        return true
    end
    local function tryNormalParry(char,kName,data)
