    RegisterTask("CloseRangeMonitor",0,function()
        if not STATE.autoParryEnabled then return end
        local localChar=localPlayer.Character
        local localRoot=localChar and localChar:FindFirstChild("HumanoidRootPart")
        if not localRoot then return end
        for killerChar,killerData in pairs(STATE.killerCharacters) do
            if not killerChar or not killerChar.Parent then
                STATE.killerCharacters[killerChar]=nil
            else
                local killerRoot=killerChar:FindFirstChild("HumanoidRootPart")
                if killerRoot then
                    local offset=localRoot.Position-killerRoot.Position
                    local flatOffset=Vector3.new(offset.X,0,offset.Z)
                    local distance=flatOffset.Magnitude
                    local killerVelocity=killerRoot.AssemblyLinearVelocity
                    local localVelocity=localRoot.AssemblyLinearVelocity
                    local relativeVelocity=Vector3.new(killerVelocity.X-localVelocity.X,0,killerVelocity.Z-localVelocity.Z)
                    local closingSpeed=0
                    if distance>0 then closingSpeed=relativeVelocity:Dot(flatOffset.Unit) end
                    local ping=math.clamp(localPlayer:GetNetworkPing(),0,0.3)
                    local predictedKiller=killerRoot.Position+Vector3.new(killerVelocity.X,0,killerVelocity.Z)*ping
                    local predictedLocal=localRoot.Position+Vector3.new(localVelocity.X,0,localVelocity.Z)*ping
                    local predictedDistance=(Vector3.new(predictedLocal.X,0,predictedLocal.Z)-Vector3.new(predictedKiller.X,0,predictedKiller.Z)).Magnitude
                    local shouldEmergency=false
                    if distance<=HARD_CLOSE_RANGE then
                        shouldEmergency=true
                    elseif distance<=CLOSE_RANGE and closingSpeed>=MIN_CLOSING_SPEED then
                        local timeToImpact=distance/closingSpeed
                        if timeToImpact<=EMERGENCY_TIME or predictedDistance<=3.75 then shouldEmergency=true end
                    end
                    if shouldEmergency then
                        local data=STATE.activeAttackers[killerChar]
                        if data and not data.consumed then
                            if doParry(true,killerChar,distance) then data.consumed=true end
                        end
                    end
                end
            end
        end
    end)
    RegisterTask("AttackersMonitor",0,function()
        if not STATE.autoParryEnabled then return end
        if next(STATE.activeAttackers)==nil then return end
        for killerChar,data in pairs(STATE.activeAttackers) do
            if not killerChar or not killerChar.Parent or not data.track then
                STATE.activeAttackers[killerChar]=nil
            elseif not data.track.IsPlaying then
                STATE.activeAttackers[killerChar]=nil
            elseif not data.consumed then
                local profile=data.profile
                local killerRoot=killerChar:FindFirstChild("HumanoidRootPart")
                local localChar=localPlayer.Character
                local localRoot=localChar and localChar:FindFirstChild("HumanoidRootPart")
                if killerRoot and localRoot and profile then
                    local offset=localRoot.Position-killerRoot.Position
                    local distance=offset.Magnitude
                    local velocity=killerRoot.AssemblyLinearVelocity
                    local localVelocity=localRoot.AssemblyLinearVelocity
                    local flatVelocity=Vector3.new(velocity.X,0,velocity.Z)
                    local flatLocalVelocity=Vector3.new(localVelocity.X,0,localVelocity.Z)
                    local flatOffset=Vector3.new(offset.X,0,offset.Z)
                    local closingSpeed=0
                    if flatOffset.Magnitude>0 then
                        closingSpeed=Vector3.new(flatVelocity.X-flatLocalVelocity.X,0,flatVelocity.Z-flatLocalVelocity.Z):Dot(flatOffset.Unit)
                    end
                    local emergency=false
                    if distance<=HARD_CLOSE_RANGE then
                        emergency=true
                    elseif distance<=CLOSE_RANGE and closingSpeed>=MIN_CLOSING_SPEED then
                        local timeToImpact=distance/closingSpeed
                        if timeToImpact<=EMERGENCY_TIME then emergency=true end
                    end
                    if emergency then
                        if doParry(true,killerChar,distance) then data.consumed=true end
                    else
                        local progress=data.track.TimePosition
                        local length=profile.length
                        local speed=profile.speed>0 and profile.speed or 1
                        local remaining=length>0 and math.max(0,(length-progress)/speed) or 0
                        local triggerByProgress=length>0 and progress>=length*profile.triggerProgress
                        local triggerByTime=remaining<=profile.triggerTime
                        if triggerByProgress or triggerByTime then
                            local range=STATE.autoParryRadius
                            if distance<=range then
                                if doParry(false,killerChar,distance) then
                                    data.consumed=true
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
