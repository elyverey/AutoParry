        if not localRoot then return end
        local localPos=localRoot.Position
        local localVel=getFlatVelocity(localRoot)
        local ping=math.clamp(localPlayer:GetNetworkPing(),0,0.3)
        local predictionTime=math.min(ping+HIDDEN_PREDICT_TIME,0.3)
        for killerChar,data in pairs(STATE.activeSkillAttackers) do
            if not killerChar or not killerChar.Parent or not data or not data.track then
                STATE.activeSkillAttackers[killerChar]=nil
            elseif not data.track.IsPlaying then
                STATE.activeSkillAttackers[killerChar]=nil
            elseif not data.consumed and data.skillId==SKILL_ANIM_ID then
                if not isIgnoredSkillKiller(data.name) then
                    local killerRoot=killerChar:FindFirstChild("HumanoidRootPart")
                    if killerRoot then
                        local killerPos=killerRoot.Position
                        local killerVel=getFlatVelocity(killerRoot)
                        local flatOffset=Vector3.new(localPos.X-killerPos.X,0,localPos.Z-killerPos.Z)
                        local distance=flatOffset.Magnitude
                        if distance<=HIDDEN_RANGE then
                            if doSkillParry(killerChar,distance) then
                                data.consumed=true
                            end
                        else
                            local predictedKiller=killerPos+killerVel*predictionTime
                            local predictedLocal=localPos+localVel*predictionTime
                            local predictedDistance=(Vector3.new(predictedLocal.X,0,predictedLocal.Z)-Vector3.new(predictedKiller.X,0,predictedKiller.Z)).Magnitude
                            if predictedDistance<=HIDDEN_RANGE then
                                if doSkillParry(killerChar,predictedDistance) then
                                    data.consumed=true
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end
