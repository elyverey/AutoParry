    RegisterTask("KillerCleanup",0,function()
        if not STATE.autoParryEnabled then return end
        for killerChar in pairs(STATE.killerCharacters) do
            if not killerChar or not killerChar.Parent then
                STATE.killerCharacters[killerChar]=nil
                STATE.activeAttackers[killerChar]=nil
