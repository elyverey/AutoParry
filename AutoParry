        for killerChar,state in pairs(STATE.skillStates) do
            if killerChar and killerChar.Parent and state and state.started and tick()-state.started<=SKILL_CHAIN_TIMEOUT then
                local humanoid=killerChar:FindFirstChildOfClass("Humanoid")
                local animator=humanoid and humanoid:FindFirstChildOfClass("Animator")
                if animator then
                    for _,track in ipairs(animator:GetPlayingAnimationTracks()) do
