    local function doParry(force)
        if not STATE.autoParryEnabled then return false end
        local now=tick()
        if now-STATE.lastParryTime<0.008 then return false end
        STATE.lastParryTime=now
        sendParryInput()
        return true
    end
    local function isIgnoredSkillKiller(killerName)
        if typeof(killerName)~="string" then return false end
        local name=killerName:lower()
        if name=="the hidden" then
            return STATE.ignoredTheHidden
        elseif name=="the abysswalker" then
            return STATE.ignoredTheAbysswalker
        elseif name=="the masked (duck)" or name=="the masked" then
            return STATE.ignoredTheMaskedDuck
        end
        return false
    end
    local function getLocalRoot()
        local char=localPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end
    local function getFlatDistance(char)
        local localRoot=getLocalRoot()
        local killerRoot=char and char:FindFirstChild("HumanoidRootPart")
        if not localRoot or not killerRoot then return math.huge end
        local a=localRoot.Position
        local b=killerRoot.Position
        return (Vector3.new(a.X,0,a.Z)-Vector3.new(b.X,0,b.Z)).Magnitude
    end
    local function parrySkillImmediately(char,data)
        if not STATE.autoParryEnabled or data.consumed then return false end
        if isIgnoredSkillKiller(data.name) then return false end
        local distance=getFlatDistance(char)
        if distance<=SKILL_DETECTION_RANGE then
            if doParry(true) then
                data.consumed=true
                return true
            end
        end
        return false
    end
    local function registerSkillStart(char,kName,track)
        if isIgnoredSkillKiller(kName) then return end
        local state=STATE.skillStates[char]
        if state then
            state.started=tick()
            state.track=track
            state.startPlaying=true
            return
        end
        STATE.skillStates[char]={name=kName,started=tick(),track=track,startPlaying=true,lunging=false}
        local conn
        conn=track.Stopped:Connect(function()
            if conn then conn:Disconnect() end
            task.delay(0.15,function()
                local current=STATE.skillStates[char]
                if current and current.track==track and not current.lunging then
                    STATE.skillStates[char]=nil
                end
            end)
        end)
    end
    local function registerSpecialSkill(char,kName,track,skillId,hiddenOnly)
        if hiddenOnly and kName:lower()~="the hidden" then return end
        if isIgnoredSkillKiller(kName) then return end
        local data={name=kName,track=track,type="special_skill",started=tick(),consumed=false,skillId=skillId}
        STATE.activeSkillAttackers[char]=data
        parrySkillImmediately(char,data)
        local conn
        conn=track.Stopped:Connect(function()
            if conn then conn:Disconnect() end
            task.delay(0.08,function()
                if STATE.activeSkillAttackers[char] and STATE.activeSkillAttackers[char].track==track then
                    STATE.activeSkillAttackers[char]=nil
                end
            end)
        end)
    end
    local function OnParryCharacterAdded(player,char)
        if player==localPlayer then return end
        task.wait(0.5)
        if not char.Parent then return end
        local killerName=getKillerName(player,char)
        if killerName or (player.Team and player.Team.Name:lower():find("killer")) then
            local kName=killerName or "Unknown Killer"
            STATE.killerCharacters[char]={player=player,name=kName}
            char.AncestryChanged:Connect(function(_,parent)
                if not parent then
                    STATE.killerCharacters[char]=nil
                    STATE.activeAttackers[char]=nil
                    STATE.activeSkillAttackers[char]=nil
                    STATE.skillStates[char]=nil
                end
            end)
            local humanoid=char:WaitForChild("Humanoid",3)
            if humanoid then
                local animator=humanoid:WaitForChild("Animator",3)
                if animator then
                    animator.AnimationPlayed:Connect(function(track)
                        if not STATE.autoParryEnabled then return end
                        if not track or not track.Animation then return end
                        local animId=track.Animation.AnimationId
                        if animId==SKILL_START_ANIM then
                            registerSkillStart(char,kName,track)
                            return
                        end
                        if animId==SKILL_LUNGE_ANIM then
                            registerSpecialSkill(char,kName,track,SKILL_LUNGE_ID,false)
                            return
                        end
                        if animId==HIDDEN_SKILL_ANIM then
                            registerSpecialSkill(char,kName,track,HIDDEN_SKILL_ID,true)
                            return
                        end
                        local profile=VALID_ANIM_IDS[animId]
                        if not profile then return end
                        local old=STATE.activeAttackers[char]
                        if old and old.track and old.track.IsPlaying then
                            if old.profile and old.profile.type=="lungehold" and profile.type=="attack" then
                                old.track=track
                                old.profile=profile
                                old.type=profile.type
                                old.id=tonumber(animId:match("%d+"))
                                old.started=tick()
                                old.consumed=false
                                return
                            end
                        end
                        local numericId=tonumber(animId:match("%d+"))
                        local data={name=kName,track=track,type=profile.type,id=numericId,profile=profile,started=tick(),consumed=false,lastTimePosition=-1}
                        STATE.activeAttackers[char]=data
                        local conn
                        conn=track.Stopped:Connect(function()
                            if conn then conn:Disconnect() end
                            task.delay(0.12,function()
                                if STATE.activeAttackers[char] and STATE.activeAttackers[char].track==track then
                                    STATE.activeAttackers[char]=nil
                                end
                            end)
                        end)
                    end)
                end
            end
        end
    end
