                            elseif animId==HIDDEN_SKILL_ANIM and state.name:lower()=="the hidden" then
                                if not STATE.activeSkillAttackers[killerChar] then
                                    registerSpecialSkill(killerChar,state.name,track,HIDDEN_SKILL_ID,true)
                                end
                                break
                            end
                        end
                    end
                end
            end
        end
    end)
    RegisterTask("SkillStateCleanup",0,function()
