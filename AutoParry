    local function getTrackProgress(track,profile)
        if not track then return 0,0,0 end
        local position=track.TimePosition or 0
        local realLength=track.Length
        local length=(realLength and realLength>0) and realLength or (profile and profile.length or 0)
        local speed=(profile and profile.speed) or 1
        local normalizedTime=position*speed
