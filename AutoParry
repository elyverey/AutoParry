                        if distance<=HARD_CLOSE_RANGE then
                            shouldParry=true
                        elseif distance<=STATE.autoParryRadius+LUNGE_TRAJECTORY_REACH and (animationReady or lungeReady or lungeCritical) then
                            shouldParry=true
                        end
