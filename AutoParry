    RegisterTask("AttackersMonitor",0,function()
        if not STATE.autoParryEnabled then return end
        if next(STATE.activeAttackers)==nil then return end
        for killerChar,data in pairs(STATE.activeAttackers) do
            if not killerChar or not killerChar.Parent or not data.track then
                STATE.activeAttackers[killerChar]=nil
            elseif not data.track.IsPlaying then
                STATE.activeAttackers[killerChar]=nil
            else
                local killerRoot=killerChar:FindFirstChild("HumanoidRootPart")
                local localChar=localPlayer.Character
                local localRoot=localChar and localChar:FindFirstChild("HumanoidRootPart")
                if killerRoot and localRoot then
                    if data.type=="attack" or data.type=="lungehold" then
                        local position=data.track.TimePosition or 0
                        local length=data.track.Length or 0
                        local knownLength=ANIM_LENGTHS[data.id]
                        local effectiveLength=knownLength or length
                        local isFastAttack=FAST_ATTACK_ANIMS[data.id] or false
                        local minPosition=isFastAttack and 0.018 or 0.06
                        local minProgress=isFastAttack and 0.012 or 0.04
                        if effectiveLength<=1.05 and isFastAttack then
                            minPosition=0.018
                            minProgress=0.012
                        elseif effectiveLength<=1.55 and isFastAttack then
                            minPosition=0.022
                            minProgress=0.014
                        elseif effectiveLength<=1.80 and isFastAttack then
                            minPosition=0.025
                            minProgress=0.015
                        elseif effectiveLength>1.80 and isFastAttack then
                            minPosition=0.035
                            minProgress=0.018
                        end
                        if position>=minPosition and (effectiveLength<=0 or position/effectiveLength>=minProgress) and (effectiveLength<=0 or position/effectiveLength<=0.985) then
                            local weight=data.track.WeightCurrent or 0
                            local priority=data.track.Priority
                            if weight>0.005 and priority~=Enum.AnimationPriority.Core and priority~=Enum.AnimationPriority.Idle and priority~=Enum.AnimationPriority.Movement then
                                if not data.lastTimePosition or position+0.0001>=data.lastTimePosition then
                                    data.lastTimePosition=position
                                    local extraRadius=data.fastAttack and 2 or 0
                                    local maxRadius=STATE.autoParryRadius+extraRadius
                                    local distance=(localRoot.Position-killerRoot.Position).Magnitude
                                    if distance<=maxRadius then
                                        local ping=Players.LocalPlayer:GetNetworkPing()
                                        local clampedPing=math.clamp(ping,0,0.3)
                                        local velocity=killerRoot.AssemblyLinearVelocity
                                        local flatVelocity=Vector3.new(velocity.X,0,velocity.Z)
                                        local predictedPos=killerRoot.Position+(flatVelocity*clampedPing)
                                        local predictedDistance=(localRoot.Position-predictedPos).Magnitude
                                        if predictedDistance<=maxRadius+2 then
                                            local directionToPlayer=localRoot.Position-killerRoot.Position
                                            if directionToPlayer.Magnitude<=0 or flatVelocity.Magnitude<=8 or flatVelocity.Unit:Dot(directionToPlayer.Unit)>=-0.1 then
                                                doParry()
                                                data.consumed=true
                                            end
                                        end
                                    end
                                else
                                    data.lastTimePosition=position
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    RegisterTask("SkillAttackersMonitor",0,function()
        if not STATE.autoParryEnabled then return end
