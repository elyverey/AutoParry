                    local relativeVel=killerFlatVel-localFlatVel
                    local closingSpeed=currentDistance>0 and relativeVel:Dot(flatOffset.Unit) or 0
                    local timeBuffer=0.20+ping
                    local dynamicRange=STATE.autoParryRadius+math.max(0,closingSpeed*timeBuffer)
                    local predictedKillerPos=killerPos+killerFlatVel*(ping+0.04)
                    local predictedLocalPos=localPos+localFlatVel*ping
                    local predictedDistance=(Vector3.new(predictedLocalPos.X,0,predictedLocalPos.Z)-Vector3.new(predictedKillerPos.X,0,predictedKillerPos.Z)).Magnitude
                    local isHeadingTowards=true
                    if killerFlatVel.Magnitude>3 and flatOffset.Magnitude>0 then
