    RegisterTask("AttackersMonitor",0,function()
        if not STATE.autoParryEnabled then return end
        for killerChar,data in pairs(STATE.activeAttackers) do
            if not killerChar or not killerChar.Parent or not data.track then
                STATE.activeAttackers[killerChar]=nil
            elseif not data.track.IsPlaying then
                STATE.activeAttackers[killerChar]=nil
            elseif not data.consumed then
                local profile=data.profile
                local killerRoot=killerChar:FindFirstChild("HumanoidRootPart")
                local localRoot=getLocalRoot()
                if killerRoot and localRoot and profile then
                    local localPos=Vector3.new(localRoot.Position.X,0,localRoot.Position.Z)
                    local killerPos=Vector3.new(killerRoot.Position.X,0,killerRoot.Position.Z)
                    local offset=localPos-killerPos
                    local distance=offset.Magnitude
                    local position=data.track.TimePosition or 0
                    local realLength=data.track.Length
                    local length=(realLength and realLength>0) and realLength or profile.length
                    local speed=profile.speed
                    local normalizedTime=position*speed
                    local normalizedLength=length/speed
                    local progress=normalizedLength>0 and normalizedTime/normalizedLength or 0
                    local triggerTime=profile.triggerTime/profile.speed
                    local triggerProgress=profile.triggerProgress
                    local triggerReached=position>=triggerTime or progress>=triggerProgress
                    if triggerReached and distance<=STATE.autoParryRadius then
                        local killerVelocity=killerRoot.AssemblyLinearVelocity
                        local flatVelocity=Vector3.new(killerVelocity.X,0,killerVelocity.Z)
                        local movingCorrectly=true
                        if offset.Magnitude>0 and flatVelocity.Magnitude>3 then
                            movingCorrectly=flatVelocity.Unit:Dot(offset.Unit)>=STATE.aimStrictness
                        end
                        if movingCorrectly then
                            local ping=math.clamp(localPlayer:GetNetworkPing(),0,0.3)
                            local localVelocity=localRoot.AssemblyLinearVelocity
                            local flatLocalVelocity=Vector3.new(localVelocity.X,0,localVelocity.Z)
                            local relativeVelocity=flatVelocity-flatLocalVelocity
                            local predictedPos=killerRoot.Position+relativeVelocity*ping
                            local predictedDistance=(Vector3.new(localRoot.Position.X,0,localRoot.Position.Z)-Vector3.new(predictedPos.X,0,predictedPos.Z)).Magnitude
                            if predictedDistance<=STATE.autoParryRadius+2 then
                                if doParry(false) then data.consumed=true end
                            end
                        end
                    end
                end
            end
        end
    end)
    RegisterTask("SpecialSkillMonitor",0,function()
