    local function makeRayParams(localChar,killerChar)
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.IgnoreWater=true
        params.FilterDescendantsInstances={localChar,killerChar}
        return params
    end
    local function multiHeightRay(origin,target,params)
        local delta=target-origin
        if delta.Magnitude<=0.05 then return true,nil end
        local offsets={
            Vector3.new(0,0,0),
            Vector3.new(0,0.9,0),
            Vector3.new(0,1.6,0),
            Vector3.new(0,-0.65,0),
            Vector3.new(0,-1.15,0)
        }
        local lastHit=nil
        for _,offset in ipairs(offsets) do
            local result=Workspace:Raycast(origin+offset,delta,params)
            if not result then
                return true,nil
            end
            lastHit=result
        end
        return false,lastHit
    end
    local function checkAttackPath(killerChar,allowVault,distance)
        local localChar=localPlayer.Character
        local localRoot=localChar and localChar:FindFirstChild("HumanoidRootPart")
        local killerRoot=killerChar and killerChar:FindFirstChild("HumanoidRootPart")
        if not localRoot or not killerRoot then return false end
        local params=makeRayParams(localChar,killerChar)
        local clear,hit=multiHeightRay(localRoot.Position,killerRoot.Position,params)
        if clear then return true end
        if allowVault and hit and isVaultObstacle(hit.Instance) and distance and distance<=STATE.autoParryRadius+VAULT_EXTRA_RANGE then
            return true
        end
        return false
    end
    local function getFlatVelocity(root)
        local v=root.AssemblyLinearVelocity
        return Vector3.new(v.X,0,v.Z)
    end
    local function getClosingSpeed(localRoot,killerRoot)
        local offset=localRoot.Position-killerRoot.Position
        local flatOffset=Vector3.new(offset.X,0,offset.Z)
        if flatOffset.Magnitude<=0.05 then return math.huge end
        local relative=getFlatVelocity(killerRoot)-getFlatVelocity(localRoot)
        return relative:Dot(flatOffset.Unit)
    end
    local function checkLungeTrajectory(killerChar,distance,closingSpeed)
        if not killerChar or not killerChar.Parent then return false end
        if not distance or distance==math.huge then return false end
        if distance>STATE.autoParryRadius+LUNGE_TRAJECTORY_REACH then return false end
        if closingSpeed<LUNGE_MIN_SPEED and distance>HARD_CLOSE_RANGE then return false end
        local localChar=localPlayer.Character
        local localRoot=localChar and localChar:FindFirstChild("HumanoidRootPart")
        local killerRoot=killerChar:FindFirstChild("HumanoidRootPart")
        if not localRoot or not killerRoot then return false end
        local params=makeRayParams(localChar,killerChar)
        local localPos=localRoot.Position
        local killerPos=killerRoot.Position
        local localVel=getFlatVelocity(localRoot)
        local killerVel=getFlatVelocity(killerRoot)
        local relativeVel=killerVel-localVel
        local flatOffset=Vector3.new(localPos.X-killerPos.X,0,localPos.Z-killerPos.Z)
        local baseDistance=flatOffset.Magnitude
        if baseDistance<=HARD_CLOSE_RANGE then return true end
        local horizon=LUNGE_TRAJECTORY_TIME
        local ping=math.clamp(localPlayer:GetNetworkPing(),0,0.3)
        horizon=math.max(horizon,ping+0.12)
        for i=1,LUNGE_TRAJECTORY_STEPS do
            local t=(i/LUNGE_TRAJECTORY_STEPS)*horizon
            local predictedKiller=killerPos+killerVel*t
            local predictedLocal=localPos+localVel*t
            local predictedOffset=Vector3.new(predictedLocal.X-predictedKiller.X,0,predictedLocal.Z-predictedKiller.Z)
            local predictedDistance=predictedOffset.Magnitude
            if predictedDistance<=STATE.autoParryRadius+LUNGE_TRAJECTORY_REACH then
                local clear=multiHeightRay(predictedKiller,predictedLocal,params)
                if clear then
                    local approach=relativeVel
                    local speed=predictedDistance>0 and approach:Dot(predictedOffset.Unit) or math.huge
                    if speed>=2 or predictedDistance<=HARD_CLOSE_RANGE then
                        return true
                    end
                end
            end
        end
        local direction=flatOffset.Magnitude>0 and flatOffset.Unit or Vector3.zero
        local side=Vector3.new(-direction.Z,0,direction.X)
        local lateralOffsets={-3,-1.5,1.5,3}
        for _,sideAmount in ipairs(lateralOffsets) do
            local lateral=side*sideAmount
            local predictedKiller=killerPos+killerVel*math.min(horizon,0.3)+lateral
            local predictedLocal=localPos+localVel*math.min(horizon,0.3)
            local predictedOffset=Vector3.new(predictedLocal.X-predictedKiller.X,0,predictedLocal.Z-predictedKiller.Z)
            if predictedOffset.Magnitude<=STATE.autoParryRadius+LUNGE_TRAJECTORY_REACH then
                local clear=multiHeightRay(predictedKiller,predictedLocal,params)
                if clear then
                    return true
                end
            end
        end
        return false
    end
    local function canParryAgainst(killerChar,distance,range,allowVault,isLunge,closingSpeed)
        if not killerChar or not killerChar.Parent then return false end
        if not distance or distance==math.huge then return false end
        if distance>range+(allowVault and VAULT_EXTRA_RANGE or 0) then return false end
        if checkAttackPath(killerChar,allowVault,distance) then return true end
        if isLunge then
            return checkLungeTrajectory(killerChar,distance,closingSpeed or 0)
        end
        return false
    end
    local function doParry(force,killerChar,distance,allowVault,isLunge,closingSpeed)
